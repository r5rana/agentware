{
  "schema": "agentware/staging-manifest@1",
  "policy_digest": "ccc03c36fc1b5e292913f17d402024767625e60a8b7d39c85cea70a6c7475d3a",
  "policy": [
    {
      "class": "vcs",
      "kind": "dir_name",
      "patterns": [
        ".git",
        ".hg",
        ".svn"
      ],
      "reason": "the donor object store is quarantined: 645 historical paths including an unrelated internal product, design documents and raw prompt logs. Working-tree copy only.",
      "ratchet": false
    },
    {
      "class": "vcs",
      "kind": "file_glob",
      "patterns": [
        ".gitmodules"
      ],
      "reason": "a submodule pointer is meaningless without the quarantined object store.",
      "ratchet": false
    },
    {
      "class": "python_cache",
      "kind": "dir_name",
      "patterns": [
        "__pycache__",
        ".pytest_cache",
        ".mypy_cache",
        ".ruff_cache",
        "htmlcov",
        ".tox"
      ],
      "reason": "build/test caches; regenerated on demand and machine-specific.",
      "ratchet": false
    },
    {
      "class": "python_cache",
      "kind": "file_glob",
      "patterns": [
        "*.pyc",
        "*.pyo",
        "*.pyd",
        ".coverage",
        ".coverage.*"
      ],
      "reason": "compiled and coverage artifacts of the caches above.",
      "ratchet": false
    },
    {
      "class": "node_cache",
      "kind": "dir_name",
      "patterns": [
        "node_modules",
        ".vite",
        ".turbo",
        ".parcel-cache"
      ],
      "reason": "installed dependency trees and bundler caches; restored from the committed lockfile.",
      "ratchet": false
    },
    {
      "class": "log_dirs",
      "kind": "dir_name",
      "patterns": [
        ".<neutralised>-logs",
        ".agentware-logs",
        "logs"
      ],
      "reason": "stray per-run log directories from the donor operator's environment; never part of the package.",
      "ratchet": false
    },
    {
      "class": "log_dirs",
      "kind": "file_glob",
      "patterns": [
        "*.log"
      ],
      "reason": "loose log files, ignored by the donor's own gitignore.",
      "ratchet": false
    },
    {
      "class": "built_bundle",
      "kind": "rel_prefix",
      "patterns": [
        "webui/dist",
        "webui/build",
        "webui/coverage",
        "webui/test-results",
        "webui/playwright-report"
      ],
      "reason": "the 7.4 MB built webui bundle and its test output; a compiled artifact of webui/src, which IS staged.",
      "ratchet": false
    },
    {
      "class": "os_noise",
      "kind": "file_glob",
      "patterns": [
        ".ds_store",
        "thumbs.db",
        "*.swp",
        "*.swo",
        "*~",
        "._*"
      ],
      "reason": "operating-system and editor droppings.",
      "ratchet": false
    },
    {
      "class": "diligence_doc",
      "kind": "file_glob",
      "patterns": [
        "*diligence*"
      ],
      "reason": "the untracked diligence document the plan excludes from every copy step. Absent from both donor snapshots as of 2026-08-14, so this rule is a RATCHET protecting that state.",
      "ratchet": true
    },
    {
      "class": "diligence_doc",
      "kind": "dir_name",
      "patterns": [
        "*diligence*"
      ],
      "reason": "the same exclusion, in case the document arrives as a folder.",
      "ratchet": true
    }
  ],
  "counts": {
    "files": 535,
    "dirs": 79,
    "bytes": 4825466
  },
