#!/usr/bin/env python3
"""agentware — deterministic CLI toolkit for an agentware workspace.

THIN ENTRYPOINT (feature 260813-modular-core-adoption, task 96).

The domain code lives in the ``agentware_lib`` package
(``scripts/agentware_lib/``, module router in ``catalog/modules.json`` and
``scripts/agentware_lib/README.md``). The strangler-fig migration that produced
it is FINISHED: every verb is served by the lib, the preserved monolith is
deleted, and there is no LEGACY arm left to fall back to.

This file is therefore only two things:

  * the ``scripts/`` sys.path bootstrap, so ``import agentware_lib...`` resolves
    in ALL load modes — direct exec, the ``tests/_fixtures.load_cli``
    SourceFileLoader, and the dashboard sidecar;

  * the DISPATCH TAIL, which hands argv to ``agentware_lib.cli.main``. The
    ``__main__`` guard is NON-NEGOTIABLE: ``load_cli()`` exec_module()s this
    file, so an unguarded ``sys.exit(...)`` would run ``main()`` at import time
    and raise SystemExit inside every test.

``agentware_lib.strangler`` is still imported here BY NAME. It is no longer a
router with two arms to choose between — every verb is ported, so its allowlist
is a completeness statement rather than a branch — but the routing tests reach
``CLI._strangler`` to assert exactly that, and a name they can no longer resolve
would turn a behavioural check into an import error.

Nothing of substance is defined here, and nothing here may grow: the whole
surface belongs in ``agentware_lib``, never in this file. That is now enforced
for the WHOLE tree rather than exempting a monolith.

EXECUTABLE BIT: this file MUST stay mode 0755. ``agentware.sh`` guards eleven
call sites on ``[[ -x scripts/agentware ]]`` and every one of them FAILS OPEN —
the R-SI-03 knowledge-loss gate returns PASS, the hook gates and the adversarial
review gate skip, KB autocommit disables itself, and nothing turns red. After any
rewrite of this file: ``chmod +x scripts/agentware``.
"""

import os
import sys

# --- agentware_lib package bootstrap -----------------------------------------
# Put scripts/ (the dir holding THIS file) on sys.path so `agentware_lib`
# resolves in ALL load modes. Idempotent; inserted at sys.path[0] only when
# absent.
_SCRIPTS_DIR = os.path.dirname(os.path.abspath(__file__))
if _SCRIPTS_DIR not in sys.path:
    sys.path.insert(0, _SCRIPTS_DIR)

# --- the modular entrypoint ---------------------------------------------------
# Task 96: the legacy passthrough is GONE. There is no body to exec, no
# post-exec rebinding (task 26's A/B repair now lives on the LIVE path in
# `agentware_lib.retrieval.regressiongate.abgate`, where the `eval` verb
# actually reaches it), and no LEGACY arm to fall back to.
import agentware_lib.cli as _cli  # noqa: E402
# Kept BY NAME: the routing tests reach `CLI._strangler` to assert which tree
# owns a verb, and with every verb ported the router is what is left to assert.
from agentware_lib import strangler as _strangler  # noqa: E402,F401

main = _cli.main

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
